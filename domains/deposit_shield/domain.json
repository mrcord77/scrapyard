{
  "name": "deposit_shield",
  "label": "Deposit Shield",
  "terminology": {},
  "data_sensitivity": "moderate",
  "brand": {
    "accent": "#2dd4bf",
    "accent2": "#34d399",
    "tagline": "Document everything. Tenants with evidence win 70% of deposit fights."
  },
  "route_policies": {
    "Tenancy": {"requires_auth": true, "owner_field": "user_id"},
    "EvidenceShot": {"requires_auth": true, "owner_field": "user_id"},
    "Deduction": {"requires_auth": true, "owner_field": "user_id"},
    "DisputeLetter": {"requires_auth": true, "owner_field": "user_id"}
  },
  "entities": [
    {
      "name": "Tenancy",
      "fields": [
        {"name": "id"},
        {"name": "user_id"},
        {"name": "address", "type": "str"},
        {"name": "landlord", "type": "str"},
        {"name": "deposit_cents", "type": "int"},
        {"name": "move_in", "type": "datetime"},
        {"name": "move_out", "type": "datetime"},
        {"name": "return_deadline_days", "type": "int"},
        {"name": "status", "type": "str"}
      ],
      "state_machine": {
        "field": "status",
        "initial": "active",
        "transitions": {
          "active": ["notice_given"],
          "notice_given": ["moved_out"],
          "moved_out": ["deposit_returned", "deductions_received"],
          "deductions_received": ["disputing", "accepted"],
          "disputing": ["resolved_full", "resolved_partial", "small_claims"],
          "small_claims": ["resolved_full", "resolved_partial", "lost"],
          "deposit_returned": [],
          "accepted": [],
          "resolved_full": [],
          "resolved_partial": [],
          "lost": []
        }
      }
    },
    {
      "name": "EvidenceShot",
      "fields": [
        {"name": "id"},
        {"name": "user_id"},
        {"name": "tenancy_id"},
        {"name": "phase", "type": "str"},
        {"name": "room", "type": "str"},
        {"name": "photo_ref", "type": "str"},
        {"name": "condition_note", "type": "text"},
        {"name": "taken_at", "type": "datetime"}
      ],
      "reference_rules": {
        "tenancy_id": {
          "entity": "Tenancy",
          "status_field": "status",
          "allowed": ["active", "notice_given", "moved_out", "deductions_received", "disputing"],
          "error": "evidence attaches to a live tenancy"
        }
      }
    },
    {
      "name": "Deduction",
      "fields": [
        {"name": "id"},
        {"name": "user_id"},
        {"name": "tenancy_id"},
        {"name": "amount_cents", "type": "int"},
        {"name": "landlord_reason", "type": "str"},
        {"name": "status", "type": "str"}
      ],
      "state_machine": {
        "field": "status",
        "initial": "contested",
        "transitions": {
          "contested": ["dropped", "upheld", "accepted"],
          "dropped": [],
          "upheld": [],
          "accepted": []
        }
      }
    },
    {
      "name": "DisputeLetter",
      "fields": [
        {"name": "id"},
        {"name": "user_id"},
        {"name": "tenancy_id"},
        {"name": "sent_at", "type": "datetime"},
        {"name": "method", "type": "str"},
        {"name": "body", "type": "text"}
      ]
    }
  ],
  "workflows": [
    "move in -> timestamped room-by-room evidence -> move out -> mirror evidence -> deductions arrive -> contest each with paired before/after proof -> dispute letter -> resolution or small claims with the full evidence log"
  ],
  "permissions": [],
  "reports": [],
  "capability_hints": []
}
