SCRAPYARD_RLS=enforce
SMTP_HOST=smtp.example.com
SCRAPYARD_LLM_PROVIDER=openai
OPENAI_API_KEY=set-your-key
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
